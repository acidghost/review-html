{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],

    // Bun runs the sources as they are, so nothing here emits; that is also
    // what lets the test files import "../server.ts" by its real name.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "skipLibCheck": true
  },
  // The tests stay JavaScript and need no types of their own.
  "include": ["binary.ts", "bundle.ts", "cli.ts", "server.ts", "state.ts", "app"]
}
