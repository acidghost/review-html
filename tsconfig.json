{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],

    // Bun runs the sources directly; TypeScript emits nothing.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "skipLibCheck": true
  },
  // Tests are checked separately with relaxed settings.
  "include": ["src"]
}
